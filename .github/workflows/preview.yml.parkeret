# PARKERET — kører ikke.
#
# Filnavnet ender på `.parkeret`, ikke `.yml`, og GitHub læser kun `.yml` og
# `.yaml` direkte i `.github/workflows/`. Filen ligger her urørt, så et
# preview pr. PR kan tages op igen uden at skulle skrives forfra.
#
# Den er afløst af `dev.yml`: ét fælles dev-miljø som det seneste PR med
# label'en `dev` får. Se docs/environments.md.
#
# Sådan tages den i brug igen:
#
#   1. Omdøb til `preview.yml`.
#   2. Slå `dev.yml` fra, eller giv de to hver sin label — de skriver begge
#      til Pi'ens dev-database og ville ellers migrere oven i hinanden.
#   3. Sæt agentens preview-løkke tilbage; den ligger parkeret samme sted i
#      `infra/pi/agent/maanslogen-agent`.
#   4. Ret navnene. Filen bygger `api-pr-42.${{ vars.DEV_DOMAIN }}`, altså et
#      navn i to niveauer. Den variabel findes ikke længere, og formen duer
#      ikke på nuværende domæne: Cloudflares gratis universalcertifikat dækker
#      `*.mathiasfoldager.com`, men ikke `*.*.mathiasfoldager.com`. Brug ét
#      niveau — `api-pr-42-maanslogen.mathiasfoldager.com` — og læs navnet fra
#      en variabel som resten gør. Se «Hvorfor navnene ser sådan ud» i
#      docs/environments.md.
#
# --------------------------------------------------------------------------

name: Preview

# Bygger PR'ets API-image og lægger det i GHCR. Pi'en henter det selv — se
# infra/pi/agent/. Der er ingen selvhostet runner: intet her rører Pi'en.
#
# Et preview opstår når label'en "preview" sættes på et PR, og forsvinder når
# den fjernes eller PR'et lukkes.
on:
  pull_request:
    types: [labeled, unlabeled, synchronize, closed]

concurrency:
  group: preview-${{ github.event.pull_request.number }}
  cancel-in-progress: true

permissions:
  contents: read
  packages: write
  pull-requests: write

jobs:
  image:
    name: Byg arm64-image til GHCR
    # Label'en er porten. Den kan kun sættes af nogen med skriveadgang, så et
    # tilfældigt PR udefra gør ingenting før du selv beder om det.
    #
    # Fork-tjekket er med som ekstra lag, men det afgørende er at en fork slet
    # ikke *kan* lægge et image op: dens GITHUB_TOKEN er skrivebeskyttet.
    if: >-
      github.event.action != 'closed' &&
      contains(github.event.pull_request.labels.*.name, 'preview') &&
      github.event.pull_request.head.repo.full_name == github.repository
    # Gratis på offentlige repoer, og native arm64 — Pi'en skal ikke have et
    # QEMU-emuleret image.
    runs-on: ubuntu-24.04-arm
    steps:
      - uses: actions/checkout@v4

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - uses: docker/setup-buildx-action@v3

      - name: Byg og læg op
        uses: docker/build-push-action@v6
        with:
          context: .
          file: apps/api/Dockerfile
          push: true
          platforms: linux/arm64
          tags: ghcr.io/${{ github.repository_owner }}/maanslogen-api:pr-${{ github.event.pull_request.number }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  web:
    name: Web-preview på Workers
    if: >-
      github.event.action != 'closed' &&
      contains(github.event.pull_request.labels.*.name, 'preview') &&
      github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - run: pnpm install --frozen-lockfile
      - run: pnpm --filter @maanslogen/contracts build

      # Adressen på PR'ets API kan regnes ud på forhånd, så web ikke skal vente
      # på hverken imaget eller Pi'en. NEXT_PUBLIC_* bages ind ved build.
      - name: Byg til Workers
        working-directory: apps/web
        env:
          NEXT_PUBLIC_API_URL: https://api-pr-${{ github.event.pull_request.number }}.${{ vars.DEV_DOMAIN }}
          NEXT_PUBLIC_MEDIA_URL: https://${{ vars.DEV_MEDIA_HOST }}
        run: pnpm cf:build

      - name: Læg versionen op
        working-directory: apps/web
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
        run: |
          pnpm exec wrangler versions upload \
            --preview-alias "pr-${{ github.event.pull_request.number }}" \
            --message "PR #${{ github.event.pull_request.number }} — ${{ github.event.pull_request.head.sha }}"

  dns:
    name: DNS for preview-API'et
    needs: image
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - env:
          CF_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CF_ZONE_ID: ${{ secrets.CLOUDFLARE_ZONE_ID }}
          CF_TUNNEL_ID: ${{ secrets.CLOUDFLARE_TUNNEL_ID }}
        run: infra/scripts/dns-record.sh upsert "api-pr-${{ github.event.pull_request.number }}.${{ vars.DEV_DOMAIN }}"

  kommentar:
    name: Skriv adresserne på PR'et
    needs: [image, web, dns]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/github-script@v7
        env:
          WEB_URL: https://pr-${{ github.event.pull_request.number }}-${{ vars.WORKER_NAME }}.${{ vars.WORKERS_SUBDOMAIN }}
          API_URL: https://api-pr-${{ github.event.pull_request.number }}.${{ vars.DEV_DOMAIN }}
        with:
          script: |
            const markør = '<!-- maanslogen-preview -->';
            const brødtekst = [
              markør,
              '### Preview',
              '',
              '| | |',
              '| --- | --- |',
              `| Site | ${process.env.WEB_URL} |`,
              `| API | ${process.env.API_URL} |`,
              '',
              'Imaget er lagt i GHCR. Pi\'en henter det selv inden for et par',
              'minutter — den modtager ikke noget herfra.',
              '',
              'Kører mod den **fælles dev-database** med testdata, som alle',
              'previews og lokal udvikling deler. En migrering i dette PR er',
              'allerede kørt på den.',
              '',
              'Fjern label\'en `preview` eller luk PR\'et, så forsvinder det igen.',
              '',
              '---',
              '_Generated by [Claude Code](https://claude.ai/code)_',
            ].join('\n');

            const { data: kommentarer } = await github.rest.issues.listComments({
              owner: context.repo.owner, repo: context.repo.repo,
              issue_number: context.issue.number,
            });
            const eksisterende = kommentarer.find((k) => k.body.includes(markør));
            if (eksisterende) {
              await github.rest.issues.updateComment({
                owner: context.repo.owner, repo: context.repo.repo,
                comment_id: eksisterende.id, body: brødtekst,
              });
            } else {
              await github.rest.issues.createComment({
                owner: context.repo.owner, repo: context.repo.repo,
                issue_number: context.issue.number, body: brødtekst,
              });
            }

  ryd-op:
    name: Ryd op
    # Når label'en fjernes eller PR'et lukkes. Containeren stopper af sig selv:
    # agenten ser at PR'et ikke længere er på listen. Her fjernes kun DNS-navnet.
    if: >-
      github.event.action == 'closed' ||
      (github.event.action == 'unlabeled' && github.event.label.name == 'preview')
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Fjern DNS-navnet
        env:
          CF_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          CF_ZONE_ID: ${{ secrets.CLOUDFLARE_ZONE_ID }}
        run: infra/scripts/dns-record.sh delete "api-pr-${{ github.event.pull_request.number }}.${{ vars.DEV_DOMAIN }}"

      - name: Skriv at miljøet er væk
        uses: actions/github-script@v7
        with:
          script: |
            const markør = '<!-- maanslogen-preview -->';
            const { data: kommentarer } = await github.rest.issues.listComments({
              owner: context.repo.owner, repo: context.repo.repo,
              issue_number: context.issue.number,
            });
            const eksisterende = kommentarer.find((k) => k.body.includes(markør));
            if (!eksisterende) return;
            await github.rest.issues.updateComment({
              owner: context.repo.owner, repo: context.repo.repo,
              comment_id: eksisterende.id,
              body: [markør, '### Preview', '', 'Miljøet er fjernet.', '',
                     '---', '_Generated by [Claude Code](https://claude.ai/code)_'].join('\n'),
            });
