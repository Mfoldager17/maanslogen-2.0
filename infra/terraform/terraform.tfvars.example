# Kopiér til terraform.tfvars. Kommer ikke i git.
#
# Tokenet sættes hellere i miljøet end her:
#   export CLOUDFLARE_API_TOKEN=...
# og så udelades cloudflare_api_token nedenfor.

account_id = "<konto-id fra dashboardets højre side>"
zone_id    = "<zone-id fra domænets oversigt>"

# Zonen navnene bygges i. Alle navne bliver <rolle>.<domain> — fx
# api-dev.maanslogen.com. Ét niveau under zonen, aldrig to; se kommentaren
# i variables.tf.
domain = "maanslogen.com"
