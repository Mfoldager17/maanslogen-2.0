# Kopiér til terraform.tfvars. Kommer ikke i git.
#
# Tokenet sættes hellere i miljøet end her:
#   export CLOUDFLARE_API_TOKEN=...
# og så udelades cloudflare_api_token nedenfor.

account_id = "<konto-id fra dashboardets højre side>"
zone_id    = "<zone-id fra domænets oversigt>"

# Zonen, ikke projektets eget domæne. Alle navne bliver bygget som
# <rolle>-<projekt>.<domain> — fx api-dev-maanslogen.mathiasfoldager.com.
domain = "mathiasfoldager.com"

# Udelades, og så bliver det "maanslogen".
# projekt = "maanslogen"
