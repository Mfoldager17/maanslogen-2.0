# Caddy står bag Cloudflare Tunnel og skal hverken skaffe certifikater eller
# lytte på 443 — tunnelen afslutter TLS. Derfor ren HTTP på 8080.
{
	auto_https off
	admin off
}

:8080 {
	log {
		output stdout
		format console
	}

	# Produktion.
	@prod host {$PROD_API_HOST}
	handle @prod {
		reverse_proxy api:4000
	}

	# Staging: main-grenens kode mod dev-databasen.
	@staging host {$STAGING_API_HOST}
	handle @staging {
		reverse_proxy api-staging:4000
	}

	# Dev: koden fra det PR der har label'en "dev" — ellers main.
	@dev host {$DEV_API_HOST}
	handle @dev {
		reverse_proxy api-dev:4000
	}

	# PARKERET: ét preview pr. PR — api-pr-42.dev... -> maanslogen-api-pr-42.
	#
	# Dev-miljøet er nu ét fælles, som @dev ovenfor dækker, og der oprettes
	# ingen api-pr-*-navne længere. Reglen ligger her urørt, så den kan tages
	# i brug igen sammen med .github/workflows/preview.yml.parkeret og
	# preview-løkken i agenten.
	#
	# @preview header_regexp pr Host ^api-pr-(\d+)\.
	# handle @preview {
	# 	reverse_proxy maanslogen-api-pr-{http.regexp.pr.1}:4000 {
	# 		fail_duration 5s
	# 	}
	# }

	# GitHub-webhooks. Modtageren kører på værten og ikke i en container,
	# fordi den skal kunne starte agenten — derfor host.docker.internal.
	@deploy host {$DEPLOY_HOST}
	handle @deploy {
		reverse_proxy host.docker.internal:9876
	}

	# Alt andet: tunnelen sender os hele trafikken, så et ukendt værtsnavn
	# skal ikke ramme noget.
	handle {
		respond "ukendt vært" 404
	}
}
