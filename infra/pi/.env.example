# Kopiér til /etc/maanslogen/pi.env på Pi'en (chmod 600). Ikke til .env her i
# mappen: GitHub-runneren tjekker repoet ud i sit eget arbejdsbibliotek, hvor en
# git-ignoreret .env aldrig ville være.
#
# En .env ved siden af docker-compose.yml virker stadig som sidste udvej til
# manuelt pilleri — se infra/pi/load-env.sh.

# ---- Database ----------------------------------------------------------
POSTGRES_USER=maanslogen
POSTGRES_PASSWORD=                 # openssl rand -base64 24

# Dev-databasen har sin egen rolle, som ikke kan forbinde til produktionen.
# Uden den adskillelse ville en preview-container kunne skrive i prod-databasen
# ved at ændre ét ord i sin forbindelses-URL.
DEV_POSTGRES_PASSWORD=             # openssl rand -base64 24

# ---- Værtsnavne (skal matche Caddyfile og DNS) -------------------------
PROD_API_HOST=api-maanslogen.mathiasfoldager.com
STAGING_API_HOST=api-staging-maanslogen.mathiasfoldager.com
DEV_API_HOST=api-dev-maanslogen.mathiasfoldager.com
# Hertil sender GitHub sine webhooks.
DEPLOY_HOST=deploy-maanslogen.mathiasfoldager.com
# Det fælles navn over sitet og API'et.
#
# Her stod før at den kunne udelades, fordi cookien "sættes og læses kun af
# API'et". Den præmis er forkert: sitets server læser den også. `api/server.ts`
# og `middleware.ts` henter cookies fra SITETS forespørgsel for at vide hvem
# du er, før siden overhovedet renderes. Er cookien host-only på API'ets vært,
# ser sitet den aldrig — du logger ind og bliver sendt til login igen.
#
# Det ses ikke lokalt, fordi cookies ikke skelner på portnummer: localhost:3000
# og localhost:4000 er samme vært, så sedlen rækkes over alligevel. Først med
# rigtige, forskellige navne falder det fra hinanden.
#
# Prisen er at cookien når alle underdomæner under mathiasfoldager.com. Det er
# afvejet: refresh-tokens roteres ved brug med familie-spærring, så et lækket
# token spærrer sig selv første gang det genbruges.
#
# API'et nægter at starte hvis et site i CORS-listen ligger uden for dette
# domæne — netop fordi den fejl ellers først viser sig som en login-løkke.
COOKIE_DOMAIN=mathiasfoldager.com
#
# Dev og staging står tomme, og det er ikke en forglemmelse. Deres sites ligger
# på workers.dev som preview-aliasser af den samme Worker, og en cookie for
# mathiasfoldager.com når aldrig derhen. De har derfor ingen session på
# serversiden — indlogget indhold virker i browseren, men sitets egen server
# kender dig ikke. Udfyld dem den dag de to får navne under domænet.
DEV_COOKIE_DOMAIN=
STAGING_COOKIE_DOMAIN=
# Adressen sitet faktisk svarer på — den bliver prod-API'ets CORS-liste.
#
# VIGTIGT: med COOKIE_DOMAIN sat skal sitet ligge UNDER det domæne. En cookie
# for mathiasfoldager.com når aldrig en workers.dev-adresse, og så virker login
# ikke. Knyt derfor custom domain til Workeren FØR du tager prod i brug.
# API'et tjekker det ved opstart og nægter at starte hvis de ikke passer sammen.
PROD_WEB_ORIGIN=https://maanslogen.mathiasfoldager.com

# Miljøerne ligger på workers.dev, lokal udvikling på localhost. Kommasepareret.
# Dev-sidens adresse er fast, fordi workflowet altid lægger op på aliaset
# `dev` — den skifter altså ikke fra PR til PR.
DEV_CORS_ORIGINS=http://localhost:3000,https://dev-maanslogen-web.<din-subdomæne>.workers.dev

# Staging-sidens adresse. Også fast — workflowet lægger altid op på aliaset
# `staging`.
STAGING_CORS_ORIGINS=https://staging-maanslogen-web.<din-subdomæne>.workers.dev

# ---- JWT ---------------------------------------------------------------
# Prod og dev har hver sit sæt. Et token fra dev må ikke virke i produktion.
JWT_ACCESS_SECRET=                 # openssl rand -base64 48
JWT_REFRESH_SECRET=                # openssl rand -base64 48
DEV_JWT_ACCESS_SECRET=             # openssl rand -base64 48
DEV_JWT_REFRESH_SECRET=            # openssl rand -base64 48

# ---- Cloudflare R2 -----------------------------------------------------
R2_ACCOUNT_ID=<account-id>
R2_BUCKET=maanslogen-media
R2_DEV_BUCKET=maanslogen-media-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=https://media-maanslogen.mathiasfoldager.com
DEV_MEDIA_PUBLIC_URL=https://media-dev-maanslogen.mathiasfoldager.com

# ---- Backup af produktionen --------------------------------------------
# Kun produktionen. Dev er testdata der kan genskabes med `prisma db seed`.
#
# Egen R2-token, ikke den ovenfor. Lav en under R2 > Manage API tokens med
# Object Read & Write, og begræns den til maanslogen-backup. Kan billed-nøglen
# også slette dumps, er backuppen ikke beskyttet mod det den sikrer imod.
R2_BACKUP_BUCKET=maanslogen-backup
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Hvor længe dumps beholdes. 0 slår oprydningen fra.
# BACKUP_RETENTION_DAYS=30

# ---- Agenten -----------------------------------------------------------
# Imaget agenten og compose henter. Pakken er offentlig, så der skal ingen
# login til.
GHCR_IMAGE=ghcr.io/mfoldager17/maanslogen-api

# Valgfrit. Repoet er offentligt, så agenten virker uden — men uden token er
# GitHubs grænse 60 kald i timen pr. IP-adresse, og med et er den 5.000.
# Brug et fine-grained token med KUN læseadgang: Pull requests (read).
# Agenten skriver aldrig noget til GitHub.
# GITHUB_TOKEN=

# Højst så mange previews ad gangen. Hver tager omkring 250 MB.
# Label'en der giver et PR dev-miljøet. Skal matche den i
# .github/workflows/dev.yml.
DEV_LABEL=dev

# Parkeret sammen med preview-koden.
# PREVIEW_LABEL=preview
# MAX_PREVIEWS=3

# Hemmeligheden GitHub signerer sine webhooks med. Den samme streng skal
# stå i repoets Settings > Webhooks. Generér med: openssl rand -hex 32
WEBHOOK_SECRET=

# ---- Tunnel ------------------------------------------------------------
# Fra Cloudflare Zero Trust > Networks > Tunnels, da tunnelen blev oprettet.
CLOUDFLARE_TUNNEL_TOKEN=
