[Unit]
Description=Sikkerhedsnet under webhooken — kør agenten hver halve time

[Timer]
OnBootSec=2min

# Til daglig er det webhooken der driver det: GitHub ringer på, og agenten
# kører med det samme. Timeren her er sikkerhedsnettet.
#
# Den findes fordi webhooks bliver væk — Pi'en genstarter, netværket blinker,
# GitHub giver op efter ti sekunder. Uden den ville en tabt besked betyde at
# en udrulning aldrig landede, og ingen ville opdage det.
#
# En halv time er rigeligt til den rolle, og det holder forbruget nede på to
# API-kald i timen mod GitHubs grænse på 60 uden token.
#
# Vil du ikke vente:
#   sudo systemctl start maanslogen-agent
OnUnitActiveSec=30min
AccuracySec=2min

[Install]
WantedBy=timers.target
