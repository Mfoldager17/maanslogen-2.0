#!/usr/bin/env bash
#
# Bringer det der kører på Pi'en i overensstemmelse med det GitHub siger der
# bør køre. Kaldes af maanslogen-agent.timer hvert andet minut.
#
# Retningen er det vigtige. Der er ingen selvhostet GitHub-runner: GitHub
# sender aldrig kode til denne maskine. Agenten spørger, og udfører kun et
# fast sæt handlinger — docker pull og docker run med argumenter den selv
# bestemmer. Den kode du læser her kommer fra main og kan ikke ændres af et PR.
#
# Tre uafhængige ting skal være opfyldt, før et PR får en container:
#
#   1. Der findes et image i GHCR. Et PR fra en fork får et skrivebeskyttet
#      GITHUB_TOKEN og kan derfor slet ikke lægge et image op. Uden image er
#      der intet at køre.
#   2. PR'et har label'en "dev". Labels kan kun sættes af nogen med
#      skriveadgang til repoet.
#   3. Grenen ligger i repoet selv, ikke i en fork. Tjekkes igen her.
#
# Tre trin, tre tags i GHCR:
#
#   :prod    produktionen — flyttes kun af et release i GitHub
#   :main    staging — lægges op ved hvert push til main
#   :dev     dev — lægges op af det PR der har label'en "dev"
#
# Der er ÉT dev-miljø, ikke ét pr. PR. Agenten spørger kun om noget åbent PR
# i repoet bærer label'en; hvilket ét er workflowets sag, for det er det der
# lægger `:dev` op, og den seneste kørsel vinder. Har ingen PR'er label'en,
# falder dev tilbage til `:main`.
#
# Koden til et preview pr. PR ligger parkeret nederst sammen med
# .github/workflows/preview.yml.parkeret.

set -euo pipefail

# Agenten kaldes nu to steder fra: timeren og webhook-modtageren. Uden en lås
# kunne de to ramme hinanden midt i en genstart af produktionen.
#
# `flock -n` betyder: kører der allerede en, så lad være — den er i gang med
# præcis det arbejde vi selv skulle til at lave. Låsen ligger i systemd's
# StateDirectory, så begge tjenester ser den samme fil.
#
# `-E 75` giver "kører allerede" sin egen exitkode (EX_TEMPFAIL). Det er ikke
# en fejl, og både unit-filen og webhook-modtageren behandler den som succes —
# ellers ville hver overlappende webhook se ud som et nedbrud i loggen.
: "${MAANSLOGEN_LAAS:=/var/lib/maanslogen/agent.lock}"
if [ -z "${MAANSLOGEN_LAAST:-}" ]; then
  mkdir -p "$(dirname "$MAANSLOGEN_LAAS")"
  exec env MAANSLOGEN_LAAST=1 flock -n -E 75 "$MAANSLOGEN_LAAS" "$0" "$@"
fi

cd "$(dirname "$0")/.."
# shellcheck source=infra/pi/load-env.sh
. ./load-env.sh

: "${GITHUB_REPO:=Mfoldager17/maanslogen-2.0}"
: "${GHCR_IMAGE:=ghcr.io/mfoldager17/maanslogen-api}"
: "${DEV_LABEL:=dev}"
# Parkeret sammen med preview-løkken nedenfor.
: "${PREVIEW_LABEL:=preview}"
: "${MAX_PREVIEWS:=3}"

log() { printf '%s %s\n' "$(date -Is)" "$*"; }

# GITHUB_TOKEN er valgfri. Repoet er offentligt, så det virker uden — men
# uautentificeret er grænsen 60 kald i timen pr. IP, og med et
# skrivebeskyttet token er den 5.000. Agenten har aldrig brug for skriveadgang.
gh_api() {
  local sti=$1
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    curl -sS --fail-with-body --max-time 20 \
      -H "Authorization: Bearer $GITHUB_TOKEN" \
      -H 'Accept: application/vnd.github+json' \
      "https://api.github.com${sti}"
  else
    curl -sS --fail-with-body --max-time 20 \
      -H 'Accept: application/vnd.github+json' \
      "https://api.github.com${sti}"
  fi
}

# ---- Er dev-miljøet gjort krav på? --------------------------------------
# Ikke *hvilket* PR — kun om nogen overhovedet har sat label'en. Hvilket PR's
# kode der ligger i `:dev`, afgøres af workflowet, hvor den seneste kørsel
# vinder. Agenten skal bare vide om den skal følge `:dev` eller `:main`.
dev_er_gjort_krav_paa() {
  gh_api "/repos/${GITHUB_REPO}/pulls?state=open&per_page=100" \
    | jq -e --arg label "$DEV_LABEL" --arg repo "$GITHUB_REPO" '
        any(.[];
          .head.repo.full_name == $repo
          and ([.labels[].name] | index($label)) != null)
      ' >/dev/null 2>&1
}

# ---- Produktion og det delte dev-API ------------------------------------
# Følger :main. Er der lagt et nyt image op, migreres og genstartes der.
# Imaget hentes af kalderen og gives videre som $6. Før hentede hver tjeneste
# sit eget, men de bruger det samme :main — så det var to identiske kald til
# GHCR hver eneste gang, altså 60 i timen der ikke udrettede noget.
opdater_tjeneste() {
  local tjeneste=$1 netvaerk=$2 database=$3 bruger=$4 kode=$5 tag=$6 ny=$7
  local image="${GHCR_IMAGE}:${tag}"

  local koerende
  koerende=$(docker inspect --format '{{.Image}}' "maanslogen-${tjeneste}" 2>/dev/null || echo ingen)

  [ "$koerende" = "$ny" ] && return 0

  log "${tjeneste}: nyt image, migrerer og genstarter"
  docker run --rm --network "$netvaerk" \
    -e DATABASE_URL="postgresql://${bruger}:${kode}@postgres:5432/${database}?schema=public" \
    "$image" ./node_modules/.bin/prisma migrate deploy >/dev/null

  # Taggen gives med som miljøvariabel; compose-filen slår den op i
  # `api-dev`'s image-linje. Skalmiljøet vinder over --env-file, så den her
  # bestemmer, uanset hvad der måtte stå i env-filen.
  API_DEV_TAG="$tag" docker compose --env-file "$MAANSLOGEN_ENV_FILE" up -d --force-recreate "$tjeneste"
  log "${tjeneste}: opdateret"
}

# ---- Kør ----------------------------------------------------------------
main() {
  # :main er staging — og dev'ens standard, når intet PR har label'en.
  docker pull -q "${GHCR_IMAGE}:main" >/dev/null
  local hovedimage
  hovedimage=$(docker inspect --format '{{.Id}}' "${GHCR_IMAGE}:main")

  # Produktionen følger :prod, og det tag flyttes kun af et release i GitHub.
  # Findes det ikke endnu, bliver produktionen stående på det den kører: at
  # falde tilbage til :main ville omgå netop den port et release er.
  if docker pull -q "${GHCR_IMAGE}:prod" >/dev/null 2>&1; then
    local prodimage
    prodimage=$(docker inspect --format '{{.Id}}' "${GHCR_IMAGE}:prod")
    opdater_tjeneste api maanslogen maanslogen \
      "$POSTGRES_USER" "$POSTGRES_PASSWORD" prod "$prodimage"
  else
    log "prod: intet :prod-image (intet release endnu) — produktionen står urørt"
  fi

  # Staging kører main-grenen. Den migreres før dev, så en migrering der kun
  # findes i et PR bliver den sidste der lægges oven på den fælles database.
  opdater_tjeneste api-staging maanslogen-dev maanslogen_dev \
    maanslogen_dev "$DEV_POSTGRES_PASSWORD" main "$hovedimage"

  # Dev følger :dev så snart et åbent PR har label'en — ellers :main, så
  # miljøet aldrig står tilbage med kode fra et PR ingen længere peger på.
  local devtag=main devimage=$hovedimage
  if dev_er_gjort_krav_paa; then
    if docker pull -q "${GHCR_IMAGE}:dev" >/dev/null 2>&1; then
      devtag=dev
      devimage=$(docker inspect --format '{{.Id}}' "${GHCR_IMAGE}:dev")
    else
      # Label'en er lige sat, og workflowet er ikke færdigt med at bygge.
      # Så bliver dev stående på main frem for at falde ud.
      log "dev: label sat, men intet :dev-image endnu — bliver på main"
    fi
  fi

  opdater_tjeneste api-dev maanslogen-dev maanslogen_dev \
    maanslogen_dev "$DEV_POSTGRES_PASSWORD" "$devtag" "$devimage"
}

