# Lokal web mod det fælles dev-miljø.
#
#   cp apps/web/.env.dev.example apps/web/.env.local
#   pnpm dev:web
#
# Så kører Next lokalt med hot reload, men data, indlogning og billeder kommer
# fra dev-API'et og dev-databasen. Postgres og MinIO behøver ikke køre.
#
# Skift tilbage med: cp apps/web/.env.example apps/web/.env.local

NEXT_PUBLIC_API_URL=https://api-dev-maanslogen.mathiasfoldager.com
NEXT_PUBLIC_MEDIA_URL=https://media-dev-maanslogen.mathiasfoldager.com
