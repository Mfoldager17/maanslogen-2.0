# API'et som browseren og serveren kalder.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Offentlig base for billeder (R2-domæne i produktion, Alarik lokalt).
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000
# Arrangementernes egen vært, fx arrangement-maanslogen.mathiasfoldager.com.
# Usat = kun én vært, og arrangementerne ligger under /arrangementer som før.
