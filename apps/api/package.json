{
  "name": "@maanslogen/api",
  "version": "2.0.0",
  "private": true,
  "description": "Maanslogen 2.0 API \u2014 NestJS, Fastify, Prisma, PostgreSQL",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "openapi:export": "tsx src/tools/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.941.0",
    "@aws-sdk/s3-request-presigner": "^3.941.0",
    "@fastify/compress": "^8.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.2",
    "@maanslogen/contracts": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.7.1",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.17.2",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "qs": "^6.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@maanslogen/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.15.3",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.6",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.2",
    "prisma": "^7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
