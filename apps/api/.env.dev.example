# Lokalt API mod dev-databasen på Pi'en — til når fejlen er i API-koden, men
# data skal være de samme som i previews.
#
#   cp apps/api/.env.dev.example apps/api/.env
#
# Forudsætter at Postgres på Pi'en er nåelig. Den lytter kun på
# docker-netværket, så lav en SSH-tunnel først:
#
#   ssh -N -L 5433:localhost:5432 pi@<pi-adresse>
#
# Bemærk at det er den fælles dev-database. Det du ændrer, ser alle previews.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# Rollen maanslogen_dev — ikke superbrugeren. Den kan kun nå dev-databasen.
DATABASE_URL="postgresql://maanslogen_dev:<DEV_POSTGRES_PASSWORD>@localhost:5433/maanslogen_dev?schema=public"

# Skal være de samme som DEV_JWT_* i infra/pi/.env, ellers afviser dev-API'et
# og det lokale API hinandens tokens.
JWT_ACCESS_SECRET=<samme som DEV_JWT_ACCESS_SECRET>
JWT_REFRESH_SECRET=<samme som DEV_JWT_REFRESH_SECRET>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

CORS_ORIGINS=http://localhost:3000

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Samme dev-bucket som previews bruger.
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=<account-id>
R2_ACCESS_KEY_ID=<nøgle>
R2_SECRET_ACCESS_KEY=<hemmelighed>
R2_BUCKET=maanslogen-media-dev
R2_PUBLIC_BASE_URL=https://media.dev.maanslogen.dk

UPLOAD_URL_TTL_SECONDS=900
PENDING_UPLOAD_TTL_MINUTES=60
ENABLE_SWAGGER=true
