# --- Kerne ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maanslogen?schema=public"

# --- Autentificering -----------------------------------------------------
# Mindst 32 tegn. Generér med: openssl rand -base64 48
JWT_ACCESS_SECRET=skift-mig-til-en-rigtig-hemmelighed-paa-mindst-32-tegn
JWT_REFRESH_SECRET=skift-mig-ogsaa-til-en-anden-hemmelighed-paa-32-tegn
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Komma-separeret. Skal sættes eksplicit i produktion.
CORS_ORIGINS=http://localhost:3000
# Udelades normalt: så bliver cookien host-only på API'ets værtsnavn. Sæt den
# kun hvis API og site deler en forælder du tør give tokenet videre til.
# COOKIE_DOMAIN=

# --- Rate limiting -------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- Objektlager ---------------------------------------------------------
# "s3" = enhver S3-kompatibel tjeneste (Alarik lokalt). "r2" = Cloudflare R2.
STORAGE_DRIVER=s3

# Lokalt (Alarik via docker/docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
# Skal matche ALARIK_REGION i docker/docker-compose.yml. Alarik afviser en
# signatur hvis regionen i credential-scopen er en anden — som rigtig S3 gør.
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=maanslogen-dev
S3_PUBLIC_BASE_URL=http://localhost:9000/maanslogen-dev
# Arrangementernes billeder. Ingen offentlig base-URL — den nås kun gennem
# en signeret URL API'et udsteder efter adgangstjekket.
S3_PRIVATE_BUCKET=maanslogen-privat-dev

# Produktion (Cloudflare R2) — sæt STORAGE_DRIVER=r2 og udfyld disse i stedet.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=maanslogen
# R2_PUBLIC_BASE_URL=https://media-maanslogen.mathiasfoldager.com

UPLOAD_URL_TTL_SECONDS=900
PENDING_UPLOAD_TTL_MINUTES=60

# --- Dokumentation -------------------------------------------------------
ENABLE_SWAGGER=true
