# --- Kerne ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database ------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maanslogen?schema=public"

# --- Autentificering -----------------------------------------------------
# Mindst 32 tegn. Generér med: openssl rand -base64 48
JWT_ACCESS_SECRET=skift-mig-til-en-rigtig-hemmelighed-paa-mindst-32-tegn
JWT_REFRESH_SECRET=skift-mig-ogsaa-til-en-anden-hemmelighed-paa-32-tegn
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Komma-separeret. Skal sættes eksplicit i produktion.
CORS_ORIGINS=http://localhost:3000
# COOKIE_DOMAIN=.maanslogen.dk

# --- Rate limiting -------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# --- Objektlager ---------------------------------------------------------
# "s3" = enhver S3-kompatibel tjeneste (MinIO lokalt). "r2" = Cloudflare R2.
STORAGE_DRIVER=s3

# Lokalt (MinIO via docker/docker-compose.yml)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=maanslogen-dev
S3_PUBLIC_BASE_URL=http://localhost:9000/maanslogen-dev

# Produktion (Cloudflare R2) — sæt STORAGE_DRIVER=r2 og udfyld disse i stedet.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=maanslogen
# R2_PUBLIC_BASE_URL=https://cdn.maanslogen.dk

UPLOAD_URL_TTL_SECONDS=900
PENDING_UPLOAD_TTL_MINUTES=60

# --- Dokumentation -------------------------------------------------------
ENABLE_SWAGGER=true
